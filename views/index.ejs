
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>Supermarket App</title>
</head>



<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="/">Student List App</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/addStudent">Add new student</a>
              </li> 
            </ul>
          </div>
        </div>
    </nav>
    <div style="margin: auto;">
        <h2 style="font-family: Arial, sans-serif; text-align: center;">Students from Student List App Database</h2>
            <table style="margin: auto; width:90%; border-collapse: collapse; text-align: center;">
                <thead>
                    <tr style="border-bottom: 2px solid #757474;">
                        <th style="font-family: Arial, sans-serif;">Student Name</th>
                        <th style="font-family: Arial, sans-serif;">Student Image</th>
                        <th style="font-family: Arial, sans-serif;">Dob</th>
                        <th style="font-family: Arial, sans-serif;">Contact</th>
                        <th style="font-family: Arial, sans-serif;">Edit</th>
                        <th style="font-family: Arial, sans-serif;">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let i=0; i < students.length; i++) { %>
                        <tr style="border-bottom: 1px solid #757474;">
                            <td style="text-align: center;"><a href="/student/<%= students[i].studentId %>" ><%= students[i].name %></a></td>
                            <td style="text-align: center;"><img src="<%= students[i].image %>" style="width: 120px; height: auto;"></td>

                            <td style="text-align: center;"><%=new Date(students[i].dob).toLocaleDateString('en-US', {
                                month: 'short',
                                day: '2-digit',
                                year: 'numeric'
                            }) %></td>
                            <td style="text-align: center;"><%= students[i].contact %></td>
                            <!-- Edit Link -->
                            <td><a href="/editStudent/<%= students[i].studentId %>">Edit</a></td>
                            <!-- Delete Link -->
                            <td><a href="/deleteStudent/<%= students[i].studentId %>" 
                                onclick="return confirm('Are you sure you want to delete this student?')">Delete</a></td>

                        </tr>
                <% } %>
            </tbody>